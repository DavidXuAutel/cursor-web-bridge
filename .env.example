# Cursor API Key (from https://cursor.com/dashboard/integrations)
CURSOR_API_KEY=cursor_...

# Workspace directory for local agent (default: current project parent)
CURSOR_CWD=/Users/xudazhong/Projects

# Server settings
HOST=0.0.0.0
PORT=8787

# Protect public endpoints (required when exposing via tunnel)
BRIDGE_API_KEY=change-me-to-a-long-random-string

# Default model
DEFAULT_MODEL=composer-2.5

# Tunnel mode: quick (temporary) | named (stable, requires domain)
# TUNNEL_MODE=quick
# TUNNEL_MODE=named
# CLOUDFLARE_HOSTNAME=cursor-bridge.example.com
# CLOUDFLARE_TUNNEL_NAME=cursor-web-bridge
